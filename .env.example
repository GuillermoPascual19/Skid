# Copia este archivo como .env (o .env.local) y rellena los valores. Nunca subas el .env al repositorio.

# Base de la API del juego. Sin definir: /api del mismo dominio (lo normal).
# Vacía (VITE_API_BASE=): el juego funciona sin ranking online.
# Solo las variables que empiezan por VITE_ llegan al navegador: no pongas secretos con ese prefijo.
VITE_API_BASE=

# Solo para desplegar desde tu ordenador (en GitHub Actions van como secrets del repositorio).
# Token de Cloudflare con la plantilla «Edit Cloudflare Workers» y permiso D1: Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
