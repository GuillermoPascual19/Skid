{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skid",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-04-01",
  // URL pública: https://skid.gpm-854.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  // El juego compilado (npm run build). Las rutas /api/* las atiende el Worker, y
  // también las páginas (para forzar HTTPS); el resto de archivos se sirven directos.
  // Una dirección que no existe muestra 404.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/legal/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skid",
      "database_id": "e31c8814-9a01-4839-b53d-7a9a016eed5b",
      "migrations_dir": "backend/migrations"
    }
  ],
  // Ráfagas de cuentas nuevas: como mucho 3 por minuto desde la misma IP.
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    // Intentos de unirse a ligas: 10 por minuto y jugador (evita probar códigos).
    {
      "name": "JOIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // ID de cliente OAuth de Google (público). Sin él no aparece el botón de Google.
  "vars": {
    "GOOGLE_CLIENT_ID": "1097617216037-1n4sbfi7fpman0fc3on4b5b23985g4fn.apps.googleusercontent.com",
    // Clave pública VAPID de las notificaciones (la privada es el secreto VAPID_PRIVATE_KEY).
    "VAPID_PUBLIC_KEY": "BJmwTicRwRFCqeHJTNHkdKJifK-JaekC5lIyPBaBiRU6UXPTLhWNBm9kCu9PTPqlq8tLN2qF22GGEZMEp5Y754o"
  },
  // Recordatorio de racha: cada día a las 18:00 UTC (las 20:00 en Madrid en verano, las 19:00 en invierno).
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true }
}
