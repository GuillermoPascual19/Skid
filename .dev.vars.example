# Secretos del Worker para desarrollo local (wrangler dev): copia este archivo como .dev.vars.
# En producción van como secretos del Worker: pnpm exec wrangler secret put <NOMBRE>
# Nunca subas .dev.vars al repositorio.

# Clave privada VAPID de las notificaciones (el valor «d» de una clave P-256, base64url).
# Su clave pública es VAPID_PUBLIC_KEY en wrangler.jsonc: si cambias una, cambia las dos.
VAPID_PRIVATE_KEY=

# Clave con la que se cifra el email en la base de datos: 32 bytes aleatorios en base64url.
# Para generarla: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_KEY=
